# Discord webhook that alerts are posted to (required)
DISCORD_WEBHOOK=

# Seconds between checks (default 900 = 15 min)
INTERVAL=300

# Months ahead to scan. One request per month, per cycle (default 12)
MONTHS=12

# Warn on Discord after this many seconds without a successful check
# (default 900 = 15 min). Raise it if the warnings get noisy.
STALE_AFTER=900
